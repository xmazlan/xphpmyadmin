{
  "name": "xphpmyadmin-desktop",
  "version": "1.4.1",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "description": "xphpMyAdmin Desktop — Modern database manager with SSH tunneling for macOS (Apple Silicon & Intel), Windows, and Linux",
  "license": "MIT",
  "author": "ROG <luanroger.dev@gmail.com>",
  "main": ".vite/build/main.js",
  "scripts": {
    "bump-ui": "tsx ./scripts/bump-ui.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "publish": "electron-forge publish",
    "start": "electron-forge start -- --no-sandbox",
    "test": "vitest run",
    "test:all": "vitest run && playwright test",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "test:watch": "vitest watch",
    "package:mac": "electron-forge package --platform=darwin --arch=arm64",
    "package:mac-intel": "electron-forge package --platform=darwin --arch=x64",
    "package:win": "electron-forge package --platform=win32 --arch=x64",
    "package:linux": "electron-forge package --platform=linux --arch=x64",
    "package:linux-arm": "electron-forge package --platform=linux --arch=arm64",
    "package:all": "yarn package:mac && yarn package:mac-intel && yarn package:win && yarn package:linux && yarn package:linux-arm",
    "make:mac": "electron-forge make --platform=darwin --arch=arm64",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "make:linux": "electron-forge make --platform=linux --arch=x64"
  },
  "overrides": {
    "@electron-forge/plugin-fuses": {
      "@electron/fuses": "^2"
    }
  },
  "resolutions": {
    "@electron/fuses": "^2"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@orpc/client": "^1.15.3",
    "@orpc/server": "^1.15.4",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "mysql2": "^3.24.6",
